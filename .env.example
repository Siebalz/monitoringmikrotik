ADMIN_USER=admin
ADMIN_PASSWORD=GANTI_PASSWORD_KUAT
# Kunci untuk enkripsi password router & sesi login. Isi acak panjang (opsional, otomatis dibuat bila kosong)
SECRET_KEY=
TZ=Asia/Jakarta
# 1 = isi dengan 8 router simulasi untuk mencoba tampilan (hapus setelah selesai mencoba)
DEMO=0
# Isi 1 jika portal diakses lewat HTTPS (disarankan bila klien login dari internet)
COOKIE_SECURE=0

# Token tunnel Cloudflare (dipakai container cloudflared, profil "tunnel"). Kosongkan bila tidak memakai Cloudflare.
CF_TUNNEL_TOKEN=
